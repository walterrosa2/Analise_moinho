# =====================================================================
# Moinho Analytics - variáveis de ambiente
# Copie para .env e ajuste. NUNCA versionar o .env real.
# =====================================================================

# --- PostgreSQL (container docker-compose) ---
POSTGRES_USER=moinho
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=moinho_analytics
POSTGRES_HOST=localhost
# 5432/5433 podem estar ocupadas por outros projetos na máquina do dev
POSTGRES_PORT=5434

# URL montada a partir das variáveis acima (src/db/settings.py).
# Defina explicitamente apenas se quiser sobrescrever.
# DATABASE_URL=postgresql+psycopg://moinho:senha@localhost:5434/moinho_analytics

# --- Diretórios de dados ---
# Origem dos arquivos Excel (somente leitura, nunca modificados pelo pipeline)
INPUT_DIR=data/input
PARQUET_DIR=data/parquet
EXPORT_DIR=data/exports
LOG_DIR=logs

# --- Aplicação ---
APP_HOST=0.0.0.0
APP_PORT=8501
# PORT=8501 # No Railway, esta variável é injetada automaticamente
LOG_LEVEL=INFO

# --- Autenticação Simples (Acesso Restrito) ---
AUTH_ENABLED=true
AUTH_USER=admin
AUTH_PASSWORD=admin

# --- Regras analíticas configuráveis ---
# Data de referência padrão para o as-of join de custos
COST_REFERENCE_DATE_FIELD=DTFATUR
# Início padrão das análises de positivados (pós-implantação do ERP)
POSITIVADOS_ANALYSIS_START=2021-05
# Tolerâncias de reconciliação (%)
RECONCILIATION_REVENUE_PCT_TOLERANCE=0.5
RECONCILIATION_VOLUME_PCT_TOLERANCE=0.5
